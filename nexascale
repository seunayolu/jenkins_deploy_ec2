pipeline {
    agent {
        label 'nexascale-node-01'
    }

    environment {
        Instance_IP = '3.9.189.251'
    }

    stages {
        stage ('fetch code') {
            steps {
                script {
                    echo "Pulling source code from Git"
                    git branch: 'jenkins', url: 'https://github.com/seunayolu/jenkins_deploy_ec2.git'
                }
            }
        }

        stage('deploy to ec2') {
            steps {
                script {
                    echo "Deploying to EC2"
                    def shellScript = "bash ./websetup.sh"
                    sshagent(['jenkins-key']) {
                        sh " scp -o StrictHostKeyChecking=no websetup.sh ubuntu@${Instance_IP}:/home/ubuntu/"
                    }
                }
            }
        }
    }
}